APP_NAME="Promo OMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://orders.example.co.za
APP_TIMEZONE=Africa/Johannesburg

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=promo_oms
DB_USERNAME=promo_oms
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_VIA_SCHEDULER=true

FILESYSTEM_DISK=local

# Microsoft 365 SMTP (enable "Authenticated SMTP" on the mailbox)
MAIL_MAILER=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# First company and admin, created by the setup script
SEED_COMPANY_NAME="Maverick Brands"
SEED_ADMIN_NAME="Brett"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

AMROD_IDENTITY_URL=https://identity.amrod.co.za
AMROD_API_URL=https://vendorapi.amrod.co.za
AMROD_TIMEOUT=600
SUPPLIER_SYNC_MEMORY=1024M
